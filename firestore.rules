rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────
    // Users collection
    // - Users can read & update their own profile
    // - Users can create their own profile on signup
    // ──────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role in ['teacher', 'student'];
      allow update: if request.auth != null && request.auth.uid == userId;
    }

    // ──────────────────────────────────────────────
    // Exams collection
    // - All authenticated users can read exams
    //   (students need to browse available exams)
    // - Only teachers can create exams (teacherId must match uid)
    // - Only the owning teacher can update/delete
    // ──────────────────────────────────────────────
    match /exams/{examId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.teacherId == request.auth.uid;
    }

    // ──────────────────────────────────────────────
    // Submissions collection
    // - All authenticated users can read submissions
    //   (teachers filter by their exam IDs client-side,
    //    students filter by their own studentId)
    // - Only students can create submissions
    //   (studentId must match uid)
    // ──────────────────────────────────────────────
    match /submissions/{submissionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.studentId == request.auth.uid;
    }
  }
}
